# =============================================================
# DNSHE Auto Renew (Node.js) 环境变量示例
# 复制为 .env 后按需填写（仅本地调试用；GitHub Actions 里
# 请使用仓库 Settings -> Secrets and variables -> Actions 配置）
# =============================================================

# ---- 运行模式 ----
# api     : 官方 API 引擎（推荐）。走 DNSHE 官方 REST API，无需浏览器，
#           稳定且极快；需要 DNSHE_API_KEY / DNSHE_API_SECRET
#           配置了 API 凭据时自动优先走此模式（无需手动设置 DNSHE_MODE）
# browser : 浏览器引擎（备用）。Playwright + 原生 Chrome CDP，
#           通过 stealth + Turnstile hook + CDP 原生鼠标点击绕过 Cloudflare 盾
#           仅在未配置 API 凭据时自动 fallback 到此模式
DNSHE_MODE=api

# ---- 官方 API 引擎凭据（推荐方案，DNSHE 后台获取）----
# 获取位置：登录 DNSHE 后台 -> 免费域名管理 -> 左侧 API 管理 -> 创建 API 密钥
# 注意：开启 2FA/TOTP 后 API 可能失效，建议保持 2FA 关闭只用 API 凭据
DNSHE_API_KEY=cfsd_xxxxxxxxxxxxxxxx
DNSHE_API_SECRET=yyyyyyyyyyyyyyyyyyyy

# ---- 推送通知 ----
# ------ Telegram 直推（推荐）------
# 直接推送到你自己的 BotFather 机器人；Bot Token 已在 substracker 里配过的话可原样共用。
# 未配置则跳过通知发送，不影响续期功能。
# TG_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxxxxxx   # @BotFather 创建 bot 获取
# TG_CHAT_ID=123456789                                  # 你的 TG 数字 user id
TG_BOT_TOKEN=
TG_CHAT_ID=

# 方式二（可选，可叠加）：通用 Webhook（POST JSON {title, content}）
# 用户自部署的 substracker 自定义 Webhook 渠道 / 企业微信机器人等：
# 形如 https://your-substracker.example.com/api/send/your-key
PUSH_URL=
# 自定义请求头（JSON 字符串，可选）
# PUSH_HEADERS={"Authorization":"Bearer token"}
# 自定义消息体模板（可选，支持 {{title}} {{content}} {{timestamp}}）
# PUSH_TEMPLATE={"title":"{{title}}","content":"{{content}}"}
PUSH_TITLE=DNSHE 域名自动续期报告

# ---- 浏览器引擎账号（仅在未配置 API 凭据时 fallback 使用）----
# 方式一：单账号
# DNSHE_USERNAME=you@example.com
# DNSHE_PASSWORD=your_password_here
# 方式二：多账号（优先级更高，JSON 数组字符串）
# USERS_JSON=[{"username":"a@example.com","password":"p1"},{"username":"b@example.com","password":"p2"}]

# ---- 验证码自动填写（浏览器模式专用，API 模式不需要）----
# 【方案一：TOTP（推荐）】在 DNSHE 后台开启 2FA/TOTP 拿到 Secret Key
# 注意：开启 2FA 后 API 可能失效，与 API 模式互斥，不建议同时开启
# DNSHE_TOTP_SECRET=
#
# 【方案二：126 邮箱 IMAP（备选）】
# MAIL_126_USER=marklow01@126.com
# MAIL_126_AUTH=xxxxxxxxxxxxxxxx

# ---- 高级选项（一般保持默认即可）----
# 剩余天数 >= 该值则跳过续期（DNSHE 续期窗口为到期前 180 天打开）
DNSHE_RENEW_THRESHOLD_DAYS=180
# API 模式相邻请求最小间隔（秒），避免触发每分钟 30 次限流
DNSHE_MIN_INTERVAL=2
# 到期时间缺省时区（UTC 偏移小时数）
DNSHE_TZ_OFFSET=8
